              ],
              "children": [
                {
                  "type": "text",
                  "id": "b2Z887",
                  "name": "Who We Are H",
                  "fill": "$navy",
                  "content": "Who We Are",
                  "fontFamily": "$font-display",
                  "fontSize": 22,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "avqim",
                  "name": "Who We Are T",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Father Damen McCaddon Council 13021 is the Knights of Columbus council of Our Lady of Lourdes Parish in Denver. We help at parish events and often host hospitality after Mass on Sundays.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "DDLrm",
                  "name": "Our Mission H",
                  "fill": "$navy",
                  "content": "Our Mission",
                  "fontFamily": "$font-display",
                  "fontSize": 22,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "H1KkXe",
                  "name": "Our Mission T",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Guided by Charity, Unity, Fraternity, and Patriotism, we serve our Church, our community, and our families. The commitment of our members enables us to give back — and our faith fuels our fire.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "L4pLRG",
                  "name": "History of the Order H",
                  "fill": "$navy",
                  "content": "History of the Order",
                  "fontFamily": "$font-display",
                  "fontSize": 22,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "z8czM",
                  "name": "History of the Order T",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The Knights of Columbus was founded in 1882 by Blessed Fr. Michael J. McGivney to protect Catholic families and practice the virtues that still guide councils like ours today.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
