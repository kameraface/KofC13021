# Council 13021 — Google Calendar connection
# Copy to .env.local (never commit .env.local). Restart `npm run dev` after editing.
# Full steps: README.md → "Connect Google Calendar"

# 1) Google Calendar → Settings → (council calendar) → Integrate calendar → Calendar ID
VITE_GOOGLE_CALENDAR_ID=

# 2) Google Cloud → APIs & Services → Credentials → API key
#    Restrict it to: Google Calendar API only.
#    Application restriction: HTTP referrers — this site's domains plus local work, e.g.
#      https://kofc13021.org/*
#      https://www.kofc13021.org/*
#      http://localhost:5173/*
VITE_GOOGLE_CALENDAR_API_KEY=
